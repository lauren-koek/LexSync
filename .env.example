OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_MODEL=your_model_here

# Local Docker Compose
DATABASE_URL=postgresql://lexsync:lexsync@localhost:5432/lexsync

# Railway: set automatically when you link the Postgres plugin — no action needed
# PIPELINE_INTERVAL_HOURS=24   # how often the pipeline runs (default: 24)
# SCRAPER_DAYS=7               # how far back to scrape (default: 7)
