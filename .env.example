# --- Required ---
OPENROUTER_API_KEY=your_api_key_here
# Local Docker Compose
DATABASE_URL=postgresql://lexsync:lexsync@localhost:5432/lexsync

# --- Optional (defaults shown) ---
# LLM used for summaries and analysis
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# CORS allow-list for the API
FRONTEND_ORIGINS=http://localhost:5173
# Where the Vite dev server proxies /api to (the backend)
VITE_API_BASE_URL=http://localhost:8000

# Railway: DATABASE_URL is set automatically when you link the Postgres plugin — no action needed
# PIPELINE_INTERVAL_HOURS=24   # how often the pipeline runs (default: 24)
# SCRAPER_DAYS=7               # how far back to scrape (default: 7)

# Note: embeddings run on a local model (BAAI/bge-small-en-v1.5 via fastembed),
# so no OpenRouter embedding key is needed.
